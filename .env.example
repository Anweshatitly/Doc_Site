# ==============================================================================
# Skin & Hair Care Clinic — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR ACTUAL SECRETS.
# NEVER COMMIT THE ACTUAL .env FILE TO GIT / VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SECURITY
# ------------------------------------------------------------------------------
# Generate a secure key with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# Must be at least 50 characters in production and not use default dev keys!
DJANGO_SECRET_KEY=change-this-to-a-cryptographically-random-50-char-secret-key-in-production

# Set to False in production! Never set to True on a public-facing server.
DJANGO_DEBUG=False

# Comma-separated list of valid domain names/IPs (NO wildcards '*' in production)
DJANGO_ALLOWED_HOSTS=yourclinic.com,www.yourclinic.com

# Obscure the Django admin path to prevent automated credential stuffing (e.g. 'clinic-mgmt-portal/')
DJANGO_ADMIN_URL=clinic-admin-portal/

# ------------------------------------------------------------------------------
# 2. HTTPS & SSL SECURITY (PRODUCTION)
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Set USE_SQLITE=True for local testing, False for production PostgreSQL
USE_SQLITE=False

# PostgreSQL Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=skincare_clinic_production
DB_USER=clinic_app_user
DB_PASSWORD=choose-a-strong-database-password-here
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. EMAIL CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@yourclinic.com
EMAIL_HOST_PASSWORD=your-app-specific-email-password

# ------------------------------------------------------------------------------
# 5. CLINIC ESSENTIALS
# ------------------------------------------------------------------------------
CLINIC_NAME=Skin & Hair Care Clinic
CLINIC_PHONE=+91-9876543210
CLINIC_WHATSAPP=+919876543210
CLINIC_EMAIL=info@yourclinic.com
CLINIC_ADDRESS=123 Aesthetics Boulevard, Medical Enclave, City, State - 700001
